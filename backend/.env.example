# UNclone Agent Backend Configuration

# DetectifAI API (from https://detectif.ai developer dashboard)
DETECTIF_API_URL=https://api.detectif.ai/v1/detect
DETECTIF_API_KEY=your_detectifai_api_key_here

# Google Gemini API (Free tier from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Whisper Configuration (options: tiny, base, small, medium)
WHISPER_MODEL_SIZE=base
WHISPER_COMPUTE_TYPE=int8

# Server Port & Allowed Origins
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
