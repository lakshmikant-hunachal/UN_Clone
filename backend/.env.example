# FamilyShield AI Backend Configuration

# JWT Secret for Session Authentication (generate random string)
JWT_SECRET=your-random-secret-key-at-least-32-characters-long

# DetectifAI API (from https://detectif.ai developer dashboard)
# If left empty, voice check will honestly show 'voice not analysed' (no invented scores)
DETECTIF_API_URL=https://api.detectif.ai/v1/detect
DETECTIF_API_KEY=

# Google Gemini API (Free tier from https://aistudio.google.com)
# If left empty, robust rule-based forensic extraction will be used
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Whisper Configuration (options: tiny, base, small)
WHISPER_MODEL_SIZE=base
WHISPER_COMPUTE_TYPE=int8

# Server Port & Allowed Origins
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
