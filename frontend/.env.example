# UNclone Agent Frontend Environment Variables

# Optional: URL of FastAPI backend (defaults to http://127.0.0.1:8000)
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Optional: Directly use DetectifAI or Gemini in Next.js API routes if backend is offline
DETECTIF_API_URL=https://api.detectif.ai/v1/detect
DETECTIF_API_KEY=your_detectifai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
